# libFuzzer dictionary for the html5 target: tokens the tokenizer and tree
# builder branch on, which random mutation rarely spells out.

# Tokenizer
"<"
">"
"</"
"/>"
"="
"'"
"\""
"`"
"<!--"
"-->"
"--!>"
"<!-->"
"<!--->"
"<!"
"<?"
"<![CDATA["
"]]>"
"<!DOCTYPE"
"<!doctype html>"
"PUBLIC"
"SYSTEM"
"\"-//W3C//DTD HTML 4.01//EN\""
"\"-//W3C//DTD HTML 4.01 Transitional//EN\""
"\"-//W3C//DTD XHTML 1.0 Transitional//EN\""
"\"-//IETF//DTD HTML//\""
"\"http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd\""

# Character references
"&"
"&#"
"&#x"
";"
"&amp;"
"&amp"
"&lt"
"&gt;"
"&quot;"
"&nbsp;"
"&not"
"&notin;"
"&notit;"
"&AElig"
"&#0;"
"&#x80;"
"&#x9F;"
"&#xD800;"
"&#x110000;"
"&#99999999999;"
"&#x;"

# Control characters, BOM, replacement character
"\x00"
"\x0B"
"\x0C"
"\x0D"
"\x0D\x0A"
"\xEF\xBB\xBF"
"\xC2\xA0"
"\xEF\xBF\xBD"

# Document structure
"<html"
"</html>"
"<head"
"</head>"
"<body"
"</body>"
"<frameset"
"</frameset>"
"<frame"
"<noframes"
"<base"
"<basefont"
"<bgsound"
"<link"
"<meta"

# Raw text, RCDATA, script data, plaintext
"<script"
"</script>"
"<!--<script"
"<style"
"</style>"
"<title"
"</title>"
"<textarea"
"</textarea>"
"<xmp"
"</xmp>"
"<iframe"
"</iframe>"
"<noembed"
"</noembed>"
"<noscript"
"</noscript>"
"<plaintext"

# Adoption agency (formatting elements)
"<a"
"</a>"
"<b"
"</b>"
"<big"
"<code"
"<em"
"<font"
"</font>"
"<i"
"</i>"
"<nobr"
"</nobr>"
"<s"
"<small"
"<strike"
"<strong"
"<tt"
"<u"
"</u>"
"</span>"

