"</td>"
"<th"
"</th>"

# Select
"<select"
"</select>"
"<option"
"</option>"
"<optgroup"
"</optgroup>"
"<selectedcontent"
"<datalist"

# Template and declarative shadow DOM
"<template"
"</template>"
"shadowrootmode=open"
"shadowrootmode=closed"

# Foreign content
"<svg"
"</svg>"
"<math"
"</math>"
"<foreignObject"
"</foreignObject>"
"<desc"
"<clipPath"
"<textPath"
"<feBlend"
"<mi"
"<mo"
"<mn"
"<ms"
"<mtext"
