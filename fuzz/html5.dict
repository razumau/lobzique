"<p"
"</p>"
"</br>"
"<br"
"<div"
"</div>"
"<address"
"<applet"
"</applet>"
"<marquee"
"</marquee>"
"<object"
"</object>"
"<button"
"</button>"
"<li"
"</li>"
"<dd"
"<dt"
"</dd>"
"<ol"
"<ul"
"<dl"
"<h1"
"</h2>"
"<pre"
"<listing"
"<form"
"</form>"
"<fieldset"
"<input"
"<image"
"<isindex"
"<keygen"
"<img"
"<hr"
"<area"
"<embed"
"<param"
"<source"
"<track"
"<wbr"
"<details"
"<summary"
"<label"
"<span"
"<ruby"
"<rb"
"<rp"
"<rt"
"<rtc"
"</ruby>"

# Tables and foster parenting
"<table"
"</table>"
"<caption"
"</caption>"
"<colgroup"
"</colgroup>"
"<col"
"<tbody"
"</tbody>"
"<thead"
"<tfoot"
"<tr"
"</tr>"
