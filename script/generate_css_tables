#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes crates/lobzique-core/src/css/tables.rs from the racc tables of the
# Nokogiri in Gemfile.lock, so the native CSS parser makes the same shift and
# reduce decisions as Nokogiri's (lib/nokogiri/css/parser.y). Rerun it when
# that version moves, and check that the rule list below still matches
# parser.y.

require "bundler/setup"
require "nokogiri"

OUTPUT = File.expand_path("../crates/lobzique-core/src/css/tables.rs", __dir__)

parser = Nokogiri::CSS::Parser
action_table, action_check, action_default, action_pointer,
  goto_table, goto_check, goto_default, goto_pointer,
  nt_base, reduce_table, token_table, shift_n, reduce_n = parser::Racc_arg

def table(name, values)
  cells = values.map { |v| v.nil? ? "N" : v.to_s }
  rows = cells.each_slice(16).map { |row| "    #{row.join(", ")}," }
  "pub const #{name}: [i16; #{values.size}] = [\n#{rows.join("\n")}\n];\n"
end

rules = reduce_table.each_slice(3).map { |length, lhs, _| [length, lhs] }
tokens = token_table.map do |symbol, id|
  name = case symbol
  when false then "END"
  when :error then "ERROR"
  when "@" then "AT"
  when "." then "DOT"
  when "*" then "STAR"
  when "|" then "PIPE"
  when ":" then "COLON"
  else symbol.to_s
  end
  "pub const #{name}: i16 = #{id};"
end

File.write(OUTPUT, <<~RUST)
  //! Generated by script/generate_css_tables from Nokogiri #{Nokogiri::VERSION}'s
  //! racc parser (lib/nokogiri/css/parser.rb, MIT, see LICENSE-NOKOGIRI.md).
  //! Do not edit.

  #![allow(clippy::unreadable_literal, dead_code)]

  /// An empty cell.
  pub const N: i16 = i16::MIN;

  #{tokens.join("\n")}

  pub const NT_BASE: i16 = #{nt_base};
  pub const SHIFT_N: i16 = #{shift_n};
  pub const REDUCE_N: i16 = #{reduce_n};

  /// Each rule's length and left-hand side, by rule number as in parser.y;
  /// rule 0 is racc's error rule.
  pub const RULES: [(u8, i16); #{rules.size}] = [
  #{rules.map { |length, lhs| "    (#{length}, #{lhs})," }.join("\n")}
  ];

  #{table("ACTION_TABLE", action_table)}
  #{table("ACTION_CHECK", action_check)}
  #{table("ACTION_DEFAULT", action_default)}
  #{table("ACTION_POINTER", action_pointer)}
  #{table("GOTO_TABLE", goto_table)}
  #{table("GOTO_CHECK", goto_check)}
  #{table("GOTO_DEFAULT", goto_default)}
  #{table("GOTO_POINTER", goto_pointer)}
RUST

system("rustfmt", "--edition", "2021", OUTPUT, exception: true)
